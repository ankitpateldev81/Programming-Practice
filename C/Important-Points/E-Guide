----------------------------------------------------------------------------------------------
ARRAY-=====>

ONE DIMENSION ARRAY-=>

1->
Declaration.
Syntax:
datatype array_name[size];

2->
Compile time initialization.
Syntax:
datatype array_name[size]={value1,value2,value3.....valueN [acc to size] };
Example:
int mark[3]={80,90,100};
mark[0]=80;
mark[1]=90;
mark[3]=100;
mark[4]=0;

3->
Run time initialization.
Syntax:
datatype array_name[size=5];

4->
Reading value.
for(i=0;i<num;i++)
scanf(%"%d",&array_name[i]);

5->
Display value.
for(i=0;i<num;i++)
printf(%"%d",array_name[i]);

6->
Sum value.
sum=0;
for(i=0;i<num;i++)
sum=sum+array_name[i];
printf(%"%d",sum);

----------------------------------------------------------------------------------------------
TWO DIMENSION ARRAY-==>

1->
Declaration.
Syntax:
datatype array_name[row size][column size];

2->
Compile time initialization.
Syntax:
datatype array_name[row size][column size]={value1,value2,value3.....valueN [acc to size of row and column (row*column=size) ] };
Example:
int mat[2][2]={10,20,30,40};
mat[0][0]=10;    mat[0][1]=20;
mat[1][0]=30;    mat[1][1]=40;

3->
Run time initialization.
Syntax:
datatype array_name[row=3][column=2];

4->
Reading value.
for(i=0;i<row;i++)
for(j=0;j<column;j++)
scanf(%"%d",&array_name[i][j]);

5->
Display value.
for(i=0;i<row;i++)
for(j=0;j<column;j++)
printf(%"%d",array_name[i][j]);

6->
Sum value.
sum=0;
for(i=0;i<row;i++)
for(j=0;j<column;j++)
sum=sum+array_name[i][j];
printf(%"%d",sum);

----------------------------------------------------------------------------------------------